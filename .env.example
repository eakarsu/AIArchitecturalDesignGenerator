NODE_ENV=development
BACKEND_PORT=3001
CLIENT_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arch_design_generator
DB_USER=postgres
DB_PASSWORD=replace-me
DB_SSL=false
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/arch_design_generator
JWT_SECRET=replace-with-at-least-32-random-characters
OPENROUTER_API_KEY=
ENABLE_EXPERIMENTAL_AI=false
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
